# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public origin of the site (used for share links, OG images and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string (32+ chars) used to sign the "unlocked" cookie for password-protected events
EVENT_COOKIE_SECRET=change-me-to-a-long-random-string
